; EditorConfig — consistent editor settings across the project.
; Mirrors .clang-format (LLVM, 4-space, 100 cols) and ruff (4-space, 100 cols).
; https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4
max_line_length = 100

[*.{c,h}]
indent_size = 4

[*.py]
indent_size = 4

[*.{yml,yaml,json,toml}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[Makefile]
indent_style = tab

[*.{mk,mak}]
indent_style = tab
